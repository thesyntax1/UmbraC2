{
  "agent_listen": "0.0.0.0:4001",
  "operator_listen": "127.0.0.1:4002",
  "http_listen": "127.0.0.1:4003",
  "http_path": "/api/v1/beacon",
  "http_tls_cert": "",
  "http_tls_key": "",
  "http_host_header": "",
  "http_pad": 0,
  "tls_listen": "",
  "tls_cert": "",
  "tls_key": "",
  "tls_client_ca": "",
  "dns_listen": "",
  "dns_domain": "tunnel.example.com",
  "vpn_listen": "",
  "vpn_addr": "",
  "vpn_network": "10.77.0.0/24",
  "socks_listen": "",
  "socks_agent": "",
  "armory_dir": "/var/lib/umbra/armory",
  "armory_key": "/var/lib/umbra/armory/pubkey.pem",
  "psk_file": "/etc/umbra/agent.psk",
  "agent_psk_env": "UMBRA_AGENT_PSK",
  "operator_token_env": [
    "UMBRA_OPERATOR_TOKENS"
  ],
  "data_file": "/var/lib/umbra/state.json",
  "audit_file": "/var/lib/umbra/audit.jsonl",
  "audit_max_mb": 32,
  "log_level": "info",
  "alerts": [
    {
      "name": "agent-offline",
      "event": "agent.offline",
      "cooldown_s": 300
    },
    {
      "name": "task-failed",
      "event": "task.result",
      "task_kind": "",
      "cooldown_s": 0
    }
  ],
  "beacon": {
    "sleep": 60,
    "jitter": 35
  },
  "limits": {
    "max_agents": 512,
    "max_operators": 16,
    "handshake_timeout_s": 10,
    "idle_timeout_s": 90,
    "max_frame_bytes_per_conn": 67108864
  },
  "max_clock_skew_s": 300,
  "session_timeout_s": 300
}
