  "http_path": "/api/v1/beacon",
  "http_tls_cert": "",
  "http_tls_key": "",
  "http_host_header": "",
  "http_pad": 0,
  "tls_listen": "",
  "tls_cert": "",
  "tls_key": "",
  "tls_client_ca": "",
  "tls_client_cn": "",
  "tls_client_spki": "",
  "dns_listen": "",
  "dns_domain": "tunnel.example.com",
  "smtp_listen": "",
  "pop3_listen": "",
  "mail_domain": "umbra.local",
  "s3_listen": "",
  "s3_region": "us-east-1",
  "s3_tasks_bucket": "umbra-tasks",
  "s3_results_bucket": "umbra-results",
  "vpn_listen": "",
  "vpn_addr": "",
  "vpn_network": "10.77.0.0/24",
  "socks_listen": "",
  "socks_agent": "",
  "socks_user": "",
  "socks_password": "",
  "pivot_deny": [],
  "dashboard_listen": "",
  "dashboard_read_only": true,
  "armory_dir": "/var/lib/umbra/armory",
  "armory_key": "/var/lib/umbra/armory/pubkey.pem",
  "psk_file": "/etc/umbra/agent.psk",
  "agent_psk_env": "UMBRA_AGENT_PSK",
  "agent_key_env": [
    "UMBRA_AGENT_KEYS"
  ],
  "operator_token_env": [
    "UMBRA_OPERATOR_TOKENS"
  ],
  "vault_key": "",
  "vault_key_env": "UMBRA_VAULT_KEY",
  "data_file": "/var/lib/umbra/state.json",
  "audit_file": "/var/lib/umbra/audit.jsonl",
  "audit_max_mb": 32,
  "log_level": "info",
  "alerts": [
    {
      "name": "agent-offline",
      "event": "agent.offline",
      "cooldown_s": 300
    },
    {
      "name": "task-failed",
      "event": "task.result",
      "task_kind": "",
      "cooldown_s": 0
    }
  ],
  "beacon": {
    "sleep": 60,
    "jitter": 35
  },
  "limits": {
    "max_agents": 512,
    "max_operators": 16,
    "handshake_timeout_s": 10,
    "idle_timeout_s": 90,
    "max_frame_bytes_per_conn": 67108864
  },
  "max_task_batch": 64,
  "max_queued_tasks": 256,
  "max_clock_skew_s": 300,
  "session_timeout_s": 300,
  "task_timeout_s": 300,
  "approval_required": [
    "wipe.run",
    "wipe.self",
    "decommission"
  ],
  "queue": {
    "max_in_flight_per_agent": 4,
    "max_deliver_per_minute_per_agent": 60,
    "max_deliver_per_second": 200,
    "max_attempts": 3,
    "breaker_threshold": 5,
    "breaker_cooldown_s": 60
  }
}
