{
  "agent_listen": "127.0.0.1:4001",
  "operator_listen": "127.0.0.1:4002",
  "http_listen": "",
  "http_path": "/api/v1/beacon",
  "http_tls_cert": "",
  "http_tls_key": "",
  "http_host_header": "",
  "http_pad": 0,
  "tls_listen": "",
  "tls_cert": "",
  "tls_key": "",
  "tls_client_ca": "",
  "dns_listen": "",
  "dns_domain": "umbra.local",
  "vpn_listen": "",
  "vpn_addr": "",
  "vpn_network": "10.77.0.0/24",
  "socks_listen": "",
  "socks_agent": "",
  "dashboard_listen": "127.0.0.1:8080",
  "dashboard_read_only": false,
  "armory_dir": "data/armory",
  "armory_key": "",
  "psk_file": "secrets/agent.psk",
  "agent_psk_env": "UMBRA_AGENT_PSK",
  "operator_token_env": [
    "UMBRA_OPERATOR_TOKENS"
  ],
  "data_file": "data/state.json",
  "audit_file": "data/audit.jsonl",
  "audit_max_mb": 8,
  "log_level": "debug",
  "alerts": [
    {
      "name": "agent-offline",
      "event": "agent.offline",
      "cooldown_s": 300
    },
    {
      "name": "task-failed",
      "event": "task.result",
      "task_kind": "",
      "cooldown_s": 0
    }
  ],
  "beacon": {
    "sleep": 5,
    "jitter": 20
  },
  "limits": {
    "max_agents": 256,
    "max_operators": 8,
    "handshake_timeout_s": 15,
    "idle_timeout_s": 120,
    "max_frame_bytes_per_conn": 67108864
  },
  "max_task_batch": 64,
  "max_queued_tasks": 256,
  "max_clock_skew_s": 300,
  "session_timeout_s": 300,
  "task_timeout_s": 300
}
